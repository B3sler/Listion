# Raspberry Pi test server: copy to /opt/listion/.env and fill in both secrets.
# Setup: docs/raspberry-pi.md

# Makes every plain `docker compose ...` in /opt/listion use the GHCR images.
COMPOSE_FILE=docker-compose.prod.yml:docker-compose.pi.yml

POSTGRES_DB=listion
POSTGRES_USER=listion_user
# openssl rand -base64 32
POSTGRES_PASSWORD=
# openssl rand -hex 32
JWT_SECRET=
