# Instance name = the user that owns /opt/listion and is in the docker group,
# e.g. listion-deploy@jonas.service. Triggered by listion-deploy@.timer.
[Unit]
Description=Update Listion to the latest main
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=%i
WorkingDirectory=/opt/listion
ExecStart=/opt/listion/deploy/pi/deploy.sh
