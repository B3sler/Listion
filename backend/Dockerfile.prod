# Backend Production Dockerfile (Simplified)
# This version assumes you've run `npm install && npm run build` on the host

FROM node:20-alpine AS production
ENV NODE_ENV=production
WORKDIR /app

# Copy package files
COPY package*.json ./
COPY backend/package.json ./backend/

# Copy pre-built dist directory from host
COPY backend/dist ./backend/dist

# Copy node_modules from host (or install if missing)
COPY node_modules ./node_modules

WORKDIR /app/backend
EXPOSE 3000
USER node
CMD ["node", "dist/main.js"]
