{
  "name": "listion",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -c \"cyan,magenta\" -n \"frontend,backend\" \"npm run --workspace frontend dev\" \"npm run --workspace backend dev\"",
    "build": "npm run --workspaces build",
    "lint": "npm run --workspaces lint",
    "type-check": "npm run --workspaces type-check",
    "test": "npm run --workspaces test",
    "format": "npm run --workspaces format",
    "setup-hooks": "npx simple-git-hooks",
    "lint:commits": "commitlint --from=origin/main --to=HEAD || echo \"Note: For local branches, adjust --from if necessary\""
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.2",
    "simple-git-hooks": "^2.14.0"
  },
  "overrides": {
    "rollup": "^4.24.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.64.5"
  },
  "simple-git-hooks": {
    "commit-msg": "npx commitlint --edit"
  }
}
